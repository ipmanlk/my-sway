#!/bin/sh
# Omarchy-like screenshots for Sway.
#   sway-screenshot region   interactive region (Print)
#   sway-screenshot full     whole screen (Shift+Print)
#   sway-screenshot window   active window (Control+Print)
# Saves to ~/Pictures/Screenshots, copies to clipboard, notifies.
set -u

DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/$(date '+%Y-%m-%d_%H-%M-%S').png"

case "${1:-region}" in
    region)
        GEOM="$(slurp)" || exit 0   # Esc cancels: stay silent
        grim -g "$GEOM" "$FILE" || exit 1
        ;;
    full)
        grim "$FILE" || exit 1
        ;;
    window)
        GEOM="$(swaymsg -t get_tree 2>/dev/null | python3 -c '
import json, sys

def find(node):
    if node.get("focused") and node.get("type") == "con" and node.get("window_rect"):
        r = node["window_rect"]
        print(f"{r[\"x\"]},{r[\"y\"]} {r[\"width\"]}x{r[\"height\"]}")
        return True
    for c in node.get("nodes", []) + node.get("floating_nodes", []):
        if find(c):
            return True
    return False

find(json.load(sys.stdin))
')" || exit 1
        [ -n "$GEOM" ] || exit 1
        grim -g "$GEOM" "$FILE" || exit 1
        ;;
    *)
        echo "usage: $0 [region|full|window]" >&2
        exit 2
        ;;
esac

wl-copy < "$FILE"
notify-send "Screenshot saved" "$FILE"
